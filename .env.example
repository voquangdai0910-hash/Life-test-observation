# Application Configuration
# The app uses a local SQLite database (backend/local_database.db),
# created automatically on first run. No external database is required.

# Set to True only for local debugging (enables verbose logging).
DEBUG=False

# JWT signing key. Generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If left blank, a random ephemeral key is generated at startup (tokens
# are then invalidated on every restart).
SECRET_KEY=

# Default upload interval in minutes
# 240 = 4 hours, 180 = 3 hours, 360 = 6 hours, 60 = 1 hour
DEFAULT_UPLOAD_INTERVAL=240

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# CORS Origins (comma-separated for production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
